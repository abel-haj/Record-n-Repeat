{
  "manifest_version": 3,
  "name": "Record-n-Repeat (FOR NOW)",
  "version": "0.1.1",
  "description": "Record and replay user actions on a web page.",
  "action": { "default_popup": "popup/index.html" },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
